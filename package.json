{
  "name": "eternity-gate",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "pnpm build:engine && expo start",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "pnpm build:engine",
    "lint": "eslint .",
    "build:engine": "pnpm --filter @eg/engine build",
    "build": "pnpm -r --filter \"./packages/**\" --if-present build",
    "validate:story": "pnpm --filter @eg/tools validate:story",
    "test": "pnpm -r test"
  },
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "pnpm@10.26.0",
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "^1.24.0",
    "expo": "~54.0.30",
    "expo-constants": "~18.0.12",
    "expo-linking": "~8.0.10",
    "expo-router": "~6.0.19",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@eslint/js": "^9.39.2",
    "@types/react": "19.1.11",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "eslint-plugin-jsonc": "^2.21.0",
    "jsonc-eslint-parser": "^2.4.2",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "react-dom": "19.1.0"
  }
}
