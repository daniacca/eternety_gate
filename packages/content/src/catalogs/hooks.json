[
  {
    "id": "hook:check:precognition",
    "type": "pre-check",
    "when": {
      "all": [
        { "fact": "attacker.condition.precognition", "op": "truthy" },
        { "fact": "attacker.condition.misfortune", "op": "falsy" }
      ]
    },
    "effects": [{ "op": "setRollMode", "mode": "best" }]
  },
  {
    "id": "hook:check:misfortune",
