      "all": [
        { "fact": "attacker.condition.misfortune", "op": "truthy" },
        { "fact": "attacker.condition.precognition", "op": "falsy" }
      ]
    },
    "effects": [{ "op": "setRollMode", "mode": "worst" }]
  },
