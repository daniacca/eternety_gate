    "ref": { "type": "condition", "id": "word_of_god" },
    "when": {
      "all": [
        { "fact": "check.kind", "op": "eq", "value": "combatAttack" },
        { "fact": "combat.wordOfGodActive", "op": "truthy" }
      ]
    },
    "effects": [
      {
        "op": "gateCheck",
        "actor": "attacker",
        "key": "WIL",
        "modifierRef": "combat.wordOfGodPenalty",
        "failTag": "combat:blocked=wordOfGod",
        "failLog": "La Parola di Dio respinge l'attacco."
      }
    ]
  },
