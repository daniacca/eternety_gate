{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://custodi.example/schemas/item.schema.json",
  "title": "Item",
  "type": "object",
  "required": ["id", "name", "type", "weight"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": ["wearable", "consumable"]
    },
    "slot": {
      "type": "string",
      "enum": ["mainHand", "offHand", "armor", "helmet", "boots", "cloak", "necklace", "ring"]
    },
    "weight": {
      "type": "number"
    },
    "maxStack": {
      "type": "number"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "grants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/grant"
      }
    },
    "shield": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parryBonus": { "type": "number" }
      }
    },
    "use": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actionId": { "type": "string" }
      }
    }
  },
  "$defs": {
    "grant": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["modifier", "unlockAction", "trait"] },
        "key": { "type": "string" },
        "op": { "type": "string", "enum": ["add"] },
        "value": { "type": "number" },
        "valueRef": { "type": "string" },
        "actionId": { "type": "string" },
        "traitId": { "type": "string" },
        "params": { "type": "object" }
      }
    }
  }
}