{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://custodi.example/schemas/actor.schema.json",
  "title": "Actor",
  "type": "object",
  "required": [
    "id",
    "name",
    "kind",
    "stats",
    "resources",
    "skills",
    "talents",
    "traits",
    "equipment",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": ["PC", "NPC"]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "stats": {
      "type": "object",
      "required": ["STR", "TOU", "AGI", "INT", "WIL", "CHA", "WS", "BS", "INI", "PER"],
      "additionalProperties": false,
      "properties": {
        "STR": { "type": "number" },
        "TOU": { "type": "number" },
        "AGI": { "type": "number" },
        "INT": { "type": "number" },
        "WIL": { "type": "number" },
        "CHA": { "type": "number" },
        "WS": { "type": "number" },
        "BS": { "type": "number" },
        "INI": { "type": "number" },
        "PER": { "type": "number" }
      }
    },
    "derived": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "mod": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "hpMax": { "type": "number" },
        "rfMax": { "type": "number" }
      }
    },
    "resources": {
      "type": "object",
      "required": ["wounds", "rf", "peq"],
      "additionalProperties": false,
      "properties": {
        "wounds": { "type": "number", "description": "Damage taken, current HP = maxHp - wounds" },
        "rf": { "type": "number", "description": "Fatigue (current RF)" },
        "peq": { "type": "number" },
        "fatePoints": { "type": "number", "description": "Fate Points for special abilities like Die Hard" },
        "fateProtectionActive": { "type": "boolean", "description": "Fate protection toggle (requires fatePoints > 0)" },
        "criticalDamage": { "type": "number" },
        "criticalTierApplied": { "type": "number" },
        "isDead": { "type": "boolean" },
        "xp": { "type": "number", "description": "Experience points for this actor" }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": { "type": "number" },
      "description": "Skills stored without SKILL: prefix, value is rank (0 = untrained)"
    },
    "talents": {
      "type": "object",
      "additionalProperties": { "type": "number" },
      "description": "Record of talentId -> rank count (1..maxRank)"
    },
    "traits": {
      "type": "object",
      "additionalProperties": true,
      "description": "Record of traitId -> params object (or true for traits without params)"
    },
    "spells": {
      "type": "object",
      "additionalProperties": { "type": "boolean" },
      "description": "Learned spells: spellId -> true"
    },
    "equipment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mainHand": { "$ref": "#/$defs/itemRef" },
        "offHand": { "$ref": "#/$defs/itemRef" },
        "armor": { "$ref": "#/$defs/itemRef" },
        "helmet": { "$ref": "#/$defs/itemRef" },
        "boots": { "$ref": "#/$defs/itemRef" },
        "cloak": { "$ref": "#/$defs/itemRef" },
        "necklace": { "$ref": "#/$defs/itemRef" },
        "ring1": { "$ref": "#/$defs/itemRef" },
        "ring2": { "$ref": "#/$defs/itemRef" }
      }
    },
    "inventory": {
      "type": "array",
      "items": { "$ref": "#/$defs/itemRef" }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/conditionInstance" },
      "description": "Conditions persist on Actor and survive leaving combat"
    },
    "status": {
      "type": "object",
      "required": ["conditions", "tempModifiers"],
      "additionalProperties": false,
      "properties": {
        "conditions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Legacy: kept for backward compatibility"
        },
        "tempModifiers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "scope", "value"],
            "additionalProperties": true,
            "properties": {
              "id": { "type": "string" },
              "scope": { "type": "string", "enum": ["check", "combat", "all"] },
              "value": { "type": "number" },
              "expires": { "type": "object", "additionalProperties": true },
              "key": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "itemRef": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["kind", "id"],
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "enum": ["weapon", "armor", "item", "misc"] },
            "id": { "type": "string" },
            "qty": { "type": "number" }
          }
        }
      ]
    },
    "conditionInstance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stacks": { "type": "number" },
        "untilTurnCounter": { "type": "number" },
        "source": { "type": "string" }
      }
    }
  }
}
