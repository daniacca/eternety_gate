{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://custodi.example/schemas/storypack.schema.json",
  "title": "StoryPack",
  "type": "object",
  "required": [
    "id",
    "title",
    "version",
    "stateSchema",
    "initialState",
    "systems",
    "startSceneId",
    "scenes"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "meta": { "type": "object", "additionalProperties": true },
    "stateSchema": { "$ref": "#/$defs/stateSchema" },
    "initialState": { "$ref": "#/$defs/initialState" },
    "systems": { "$ref": "#/$defs/systems" },
    "startSceneId": { "type": "string", "minLength": 1 },
    "cast": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "npcs": {
          "type": "array",
          "items": { "$ref": "#/$defs/actor" }
        }
      }
    },
    "effectsCatalog": { "type": "object", "additionalProperties": true },

    "weapons": {
      "type": "array",
      "items": { "$ref": "#/$defs/weapon" },
      "description": "Story-local weapons (override or extend global content pack)"
    },
    "armors": {
      "type": "array",
      "items": { "$ref": "#/$defs/armor" },
      "description": "Story-local armors"
    },
    "skills": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "talents": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "traits": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "grids": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "tiles": { "type": "object", "additionalProperties": true },

    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scene" }
    }
  },
  "$defs": {
    "stateSchema": {
      "type": "object",
      "required": ["flags", "counters"],
      "additionalProperties": true,
      "properties": {
        "flags": { "type": "object", "additionalProperties": { "type": "string" } },
        "counters": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "initialState": {
      "type": "object",
      "required": ["flags", "counters"],
      "additionalProperties": true,
      "properties": {
        "flags": { "type": "object", "additionalProperties": { "type": "boolean" } },
        "counters": { "type": "object", "additionalProperties": { "type": "number" } },
        "runVariant": { "type": "object", "additionalProperties": true }
      }
    },
    "systems": {
      "type": "object",
      "required": ["checks"],
      "additionalProperties": true,
      "properties": {
        "checks": {
          "type": "object",
          "required": ["difficultyBands", "criticals"],
          "additionalProperties": true,
          "properties": {
            "difficultyBands": { "type": "object", "additionalProperties": { "type": "integer" } },
            "criticals": {
              "type": "object",
              "required": ["autoSuccess", "autoFail"],
              "properties": {
                "autoSuccess": { "type": "array", "items": { "type": "integer" } },
                "autoFail": { "type": "array", "items": { "type": "integer" } },
                "epic": { "type": "object", "additionalProperties": true }
              },
              "additionalProperties": true
            }
          }
        },
        "worldEvents": { "type": "object", "additionalProperties": true },
        "runVariants": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      }
    },
    "scene": {
      "type": "object",
      "required": ["id", "type", "title", "text"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["narration", "dialogue", "hub", "system", "challenge", "ending"] },
        "title": { "type": "string" },
        "text": { "type": "array", "items": { "type": "string" } },
        "textBlocks": { "type": "array", "items": { "$ref": "#/$defs/textBlock" } },
        "onEnter": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } },
        "choices": { "type": "array", "items": { "$ref": "#/$defs/choice" } },
        "backgroundImage": { "$ref": "#/$defs/sceneBackground" },
        "combatEnd": { "$ref": "#/$defs/combatEnd" },
        "rewards": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "persistentConsequences": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      }
    },
    "sceneBackground": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "storyAsset" },
            "assetId": { "type": "string" },
            "ext": { "type": "string", "enum": ["png", "jpg"] }
          }
        },
        {
          "type": "object",
          "required": ["kind", "uri"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "remote" },
            "uri": { "type": "string" }
          }
        }
      ]
    },
    "combatEnd": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "onVictory": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
        "onDefeat": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
        "onAny": { "type": "array", "items": { "$ref": "#/$defs/effect" } }
      }
    },
    "textBlock": {
      "type": "object",
      "required": ["conditions", "text"],
      "additionalProperties": false,
      "properties": {
        "conditions": {
          "oneOf": [
            { "$ref": "#/$defs/condition" },
            { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } }
          ]
        },
        "text": { "type": "array", "items": { "type": "string" } }
      }
    },
    "choice": {
      "type": "object",
      "required": ["id", "label", "effects"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "conditions": {
          "oneOf": [
            { "$ref": "#/$defs/condition" },
            { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } }
          ]
        },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
        "feedbackText": { "type": "array", "items": { "type": "string" } }
      }
    },
    "condition": {
      "oneOf": [
        { "$ref": "#/$defs/condFlag" },
        { "$ref": "#/$defs/condCounterGte" },
        { "$ref": "#/$defs/condCounterLte" },
        { "$ref": "#/$defs/condAnd" },
        { "$ref": "#/$defs/condOr" },
        { "$ref": "#/$defs/condNot" }
      ]
    },
    "condFlag": {
      "type": "object",
      "required": ["op", "path", "value"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "flag" },
        "path": { "type": "string" },
        "value": { "type": "boolean" }
      }
    },
    "condCounterGte": {
      "type": "object",
      "required": ["op", "path", "value"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "counterGte" },
        "path": { "type": "string" },
        "value": { "type": "number" }
      }
    },
    "condCounterLte": {
      "type": "object",
      "required": ["op", "path", "value"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "counterLte" },
        "path": { "type": "string" },
        "value": { "type": "number" }
      }
    },
    "condAnd": {
      "type": "object",
      "required": ["op", "clauses"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "and" },
        "clauses": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } }
      }
    },
    "condOr": {
      "type": "object",
      "required": ["op", "clauses"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "or" },
        "clauses": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } }
      }
    },
    "condNot": {
      "type": "object",
      "required": ["op", "clause"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "not" },
        "clause": { "$ref": "#/$defs/condition" }
      }
    },
    "effect": {
      "type": "object",
      "required": ["op"],
      "additionalProperties": true,
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "setFlag",
            "addCounter",
            "addItem",
            "removeItem",
            "clearChoiceCheckResults",
            "goto",
            "conditionalEffects",
            "chooseRunVariant",
            "applyVariantStartEffects",
            "fireWorldEvents",
            "combatStart",
            "combatMove",
            "combatEndTurn",
            "combatDefend",
            "combatAim",
            "combatAllOut",
            "combatRequestAttack",
            "addCondition",
            "removeCondition",
            "combatKnockdown",
            "combatDisarm",
            "combatSwiftAttack",
            "combatGetProne",
            "combatStandUp",
            "combatPickup",
            "combatDrop",
            "combatEquipItem",
            "combatUnequipItem",
            "combatChannel",
            "combatCastSpell",
            "learnSpell",
            "acquireTalent",
            "grantXp",
            "grantFatePoint",
            "narrativeSpell"
          ]
        }
      }
    },
    "check": {
      "type": "object",
      "required": ["id", "kind"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["single", "multi", "condition", "opposed", "sequence", "magicChannel", "magicEffect", "combatAttack"]
        },
        "condition": { "$ref": "#/$defs/condition" },
        "actorRef": { "$ref": "#/$defs/actorRef" },
        "difficulty": { "type": "string" },
        "difficultyByCondition": {
          "type": "object",
          "required": ["default", "rules"],
          "additionalProperties": false,
          "properties": {
            "default": { "type": "string" },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["when", "difficulty"],
                "additionalProperties": false,
                "properties": {
                  "when": { "$ref": "#/$defs/condition" },
                  "difficulty": { "type": "string" }
                }
              }
            }
          }
        },
        "modifier": { "type": "integer", "description": "Optional flat modifier to apply to the check target" },
        "targetDoS": { "type": "integer", "minimum": 1, "description": "DoS to accumulate via channeling" },
        "castingNumberDoS": { "type": "integer", "minimum": 1, "description": "DoS required to manifest the effect" },
        "powerMode": { "type": "string", "enum": ["CONTROLLED", "FORCED"] },
        "onSuccess": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
        "onFailure": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
        "successText": { "type": "array", "items": { "type": "string" } },
        "failureText": { "type": "array", "items": { "type": "string" } },
        "key": { "type": "string" }
      }
    },
    "actorRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["active", "byId", "bestOfParty", "askPlayer"] },
        "actorId": { "type": "string" },
        "key": { "type": "string" }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "kind": { "type": "string", "enum": ["PC", "NPC"] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "stats": { "type": "object", "additionalProperties": { "type": "number" } },
        "resources": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "wounds": { "type": "number" },
            "rf": { "type": "number" },
            "fatePoints": { "type": "number" },
            "criticalDamage": { "type": "number" },
            "criticalTierApplied": { "type": "number" },
            "isDead": { "type": "boolean" },
            "xp": { "type": "number" }
          }
        },
        "skills": { "type": "object", "additionalProperties": { "type": "number" } },
        "talents": { "type": "object", "additionalProperties": { "type": "number" } },
        "traits": { "type": "object", "additionalProperties": true },
        "equipment": { "type": "object", "additionalProperties": true },
        "status": { "type": "object", "additionalProperties": true }
      }
    },
    "weapon": {
      "type": "object",
      "required": ["id", "name", "kind", "damage", "damageType", "penetration"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "kind": { "type": "string", "enum": ["MELEE", "RANGED"] },
        "damage": {
          "type": "object",
          "required": ["tier", "add"],
          "additionalProperties": false,
          "properties": {
            "tier": { "type": "string", "enum": ["fixed", "half", "single", "double", "triple", "quadfold", "fivefold"] },
            "add": { "type": "number" },
            "bonus": { "type": "string", "enum": ["SB"] }
          }
        },
        "damageType": { "type": "string", "enum": ["energy", "explosive", "impact", "rendering", "piercing"] },
        "penetration": { "type": "number" },
        "range": { "type": "number" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "armor": {
      "type": "object",
      "required": ["id", "name", "soak"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "soak": { "type": "number" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
