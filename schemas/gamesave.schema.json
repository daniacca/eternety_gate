{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://custodi.example/schemas/gamesave.schema.json",
  "title": "GameSave",
  "type": "object",
  "required": ["saveVersion", "story", "state", "party", "actorsById", "itemsById", "weaponsById", "armorsById", "runtime"],
  "additionalProperties": false,

  "properties": {
    "saveVersion": { "type": "string", "const": "1.0.0" },

    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" },

    "engineVersion": { "type": "string" },
    "platform": { "type": "string" },

    "story": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },

    "meta": {
      "type": "object",
      "additionalProperties": true,
      "description": "Deprecated: XP is now stored per-actor in actor.resources.xp"
    },

    "state": {
      "type": "object",
      "required": ["flags", "counters"],
      "additionalProperties": true,
      "properties": {
        "flags": { "type": "object", "additionalProperties": { "type": "boolean" } },
        "counters": { "type": "object", "additionalProperties": { "type": "number" } },
        "runVariant": { "type": "object", "additionalProperties": true }
      }
    },

    "party": { "$ref": "./party.schema.json" },

    "actorsById": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "./actor.schema.json" }
    },

    "itemsById": {
      "type": "object",
      "additionalProperties": { "$ref": "./item.schema.json" }
    },

    "weaponsById": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/weapon" }
    },

    "armorsById": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/armor" }
    },

    "runtime": {
      "type": "object",
      "required": ["currentSceneId", "rngSeed", "history", "firedWorldEvents"],
      "additionalProperties": false,
      "properties": {
        "currentSceneId": { "type": "string", "minLength": 1 },

        "rngSeed": { "type": "integer" },
        "rngCounter": { "type": "integer", "minimum": 0 },

        "history": {
          "type": "object",
          "required": ["visitedScenes", "chosenChoices"],
          "additionalProperties": false,
          "properties": {
            "visitedScenes": { "type": "array", "items": { "type": "string" } },
            "chosenChoices": { "type": "array", "items": { "type": "string" } }
          }
        },

        "firedWorldEvents": { "type": "array", "items": { "type": "string" } },

        "lastCheck": { "$ref": "#/$defs/checkResult" },
        "lastPlayerCheck": { "$ref": "#/$defs/checkResult" },

        "magic": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accumulatedDoS": { "type": "number" }
          }
        },

        "combat": { "$ref": "#/$defs/combatState" },

        "combatLog": { "type": "array", "items": { "type": "string" } },
        "combatTurnStartIndex": { "type": "integer" },
        "combatEndedSceneId": { "type": "string" },
        "combatLogSceneId": { "type": "string" },
        "combatCycleStartIndex": { "type": "integer" },

        "runtimeLog": {
          "type": "array",
          "items": { "$ref": "#/$defs/runtimeLogEntry" }
        },
        "runtimeLogSeq": { "type": "integer" },

        "gameOver": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reason": { "type": "string", "enum": ["partyDead", "playerDead"] },
            "sceneId": { "type": "string" }
          }
        }
      }
    }
  },

  "$defs": {
    "checkResult": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "checkId": { "type": "string" },
        "actorId": { "type": "string" },

        "roll": { "type": "integer", "minimum": 1, "maximum": 100 },
        "target": { "type": "number" },

        "success": { "type": "boolean" },
        "dos": { "type": "integer" },
        "dof": { "type": "integer" },

        "critical": {
          "type": "string",
          "enum": ["none", "autoSuccess", "autoFail", "epicSuccess", "epicFail"]
        },

        "tags": { "type": "array", "items": { "type": "string" } },
        "weight": { "type": "number" },
        "handedness": { "type": "string", "enum": ["oneHand", "twoHand"] },
        "ammo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["itemId", "consumedPerAttack"],
          "properties": {
            "itemId": { "type": "string" },
            "consumedPerAttack": { "type": "number" }
          }
        },
        "qualities": { "type": "array", "items": { "type": "string" } }
      }
    },

    "weapon": {
      "type": "object",
      "required": ["id", "name", "kind", "damage", "damageType", "penetration"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "kind": { "type": "string", "enum": ["MELEE", "RANGED"] },
        "damage": {
          "type": "object",
          "required": ["tier", "add"],
          "additionalProperties": false,
          "properties": {
            "tier": { "type": "string", "enum": ["fixed", "half", "single", "double", "triple", "quadfold", "fivefold"] },
            "add": { "type": "number" },
            "bonus": { "type": "string", "enum": ["SB"] }
          }
        },
        "damageType": { "type": "string", "enum": ["energy", "explosive", "impact", "rendering", "piercing"] },
        "penetration": { "type": "number" },
        "range": { "type": "number" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },

    "armor": {
      "type": "object",
      "required": ["id", "name", "soak"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "soak": { "type": "number" },
        "agiMax": { "type": "number" },
        "weight": { "type": "number" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },

    "combatState": {
      "type": "object",
      "required": ["active", "participants", "currentIndex", "round", "grid", "positions", "turn", "turnCounter"],
      "additionalProperties": false,
      "properties": {
        "active": { "type": "boolean" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "currentIndex": { "type": "integer" },
        "round": { "type": "integer" },
        "startedBySceneId": { "type": "string" },

        "grid": {
          "type": "object",
          "required": ["width", "height"],
          "additionalProperties": false,
          "properties": {
            "width": { "type": "integer" },
            "height": { "type": "integer" }
          }
        },
        "gridId": { "type": "string" },
        "positions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["x", "y"],
            "additionalProperties": false,
            "properties": {
              "x": { "type": "integer" },
              "y": { "type": "integer" }
            }
          }
        },

        "turn": {
          "type": "object",
          "required": ["moveRemaining", "actionAvailable"],
          "additionalProperties": false,
          "properties": {
            "moveRemaining": { "type": "integer" },
            "actionAvailable": { "type": "boolean" }
          }
        },

        "stancesByActorId": {
          "type": "object",
          "additionalProperties": { "type": "string", "enum": ["defend", "allOut", "aim"] }
        },

        "turnCounter": { "type": "integer" },

        "parryDisabledUntilTurnCounterByActorId": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },

        "equippedThisRoundByActorId": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },

        "groundItemsByPos": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "id"],
              "additionalProperties": false,
              "properties": {
                "kind": { "type": "string", "enum": ["weapon", "armor", "item", "misc"] },
                "id": { "type": "string" },
                "qty": { "type": "number" }
              }
            }
          }
        },

        "initialHpByActorId": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },

        "channeling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "actorId": { "type": "string" },
            "accumulatedDoS": { "type": "integer" },
            "lastChannelTurnCounter": { "type": "integer" }
          }
        },

        "freeSpellUsedThisTurn": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        }
      }
    },

    "runtimeLogEntry": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "actorId", "iniBonus", "iniRoll", "iniScore"],
          "properties": {
            "kind": { "const": "initiative" },
            "actorId": { "type": "string" },
            "iniBonus": { "type": "number" },
            "iniRoll": { "type": "number" },
            "iniScore": { "type": "number" },
            "turnCounter": { "type": "integer" },
            "resolutionId": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "attackerId", "defenderId", "rawDamage", "soak", "finalDamage"],
          "properties": {
            "kind": { "const": "damage" },
            "attackerId": { "type": "string" },
            "defenderId": { "type": "string" },
            "weaponId": { "type": "string" },
            "formula": { "type": "string" },
            "rolls": { "type": "array", "items": { "type": "number" } },
            "rawDamage": { "type": "number" },
            "soak": { "type": "number" },
            "touBonus": { "type": "number" },
            "finalDamage": { "type": "number" },
            "turnCounter": { "type": "integer" },
            "resolutionId": { "type": "string" },
            "tags": { "type": "array", "items": { "type": "string" } }
          }
        },
        {
          "type": "object",
          "required": ["kind", "check"],
          "properties": {
            "kind": { "const": "check" },
            "check": { "$ref": "#/$defs/checkResult" },
            "resolutionId": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "message"],
          "properties": {
            "kind": { "const": "system" },
            "message": { "type": "string" },
            "turnCounter": { "type": "integer" },
            "resolutionId": { "type": "string" },
            "tags": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    }
  }
}
